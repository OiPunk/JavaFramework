<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans           http://www.springframework.org/schema/beans/spring-beans.xsd">


		<import resource="applicationContext-*.xml"/>
        <!-- translatedText Spring translatedText translatedText settranslatedText  translatedText DI -->
        <bean id="person" name="human,star" class="com.mashibing.spring.Person">
        	<property name="name"><value>translatedText</value></property>
        	<property name="age" value="18" />
        	<property name="food" ref="food" />
        </bean>
        
        <bean id="food" class="com.mashibing.spring.Food"></bean>
        
        <alias name="person" alias="person2"/>
        
</beans>
